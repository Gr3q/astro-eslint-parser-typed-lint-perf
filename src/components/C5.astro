---
import C4 from "./C4.astro";
import C3 from "./C3.astro";
import type { Item } from "../types";

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const total = items.reduce((sum, item) => sum + item.value, 0);
const labels = items.map((item) => item.label.toUpperCase());
---

<section>
  <h2>C5: {total}</h2>
  <p>{labels.join(", ")}</p>
  <C4 items={items} />
  <C3 items={items} />
</section>
