---
import C8 from "./C8.astro";
import C7 from "./C7.astro";
import type { Item } from "../types";

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const total = items.reduce((sum, item) => sum + item.value, 0);
const labels = items.map((item) => item.label.toUpperCase());
---

<section>
  <h2>C9: {total}</h2>
  <p>{labels.join(", ")}</p>
  <C8 items={items} />
  <C7 items={items} />
</section>
