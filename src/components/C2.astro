---
import C1 from "./C1.astro";
import C0 from "./C0.astro";
import type { Item } from "../types";

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const total = items.reduce((sum, item) => sum + item.value, 0);
const labels = items.map((item) => item.label.toUpperCase());
---

<section>
  <h2>C2: {total}</h2>
  <p>{labels.join(", ")}</p>
  <C1 items={items} />
  <C0 items={items} />
</section>
