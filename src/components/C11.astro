---
import C10 from "./C10.astro";
import C9 from "./C9.astro";
import type { Item } from "../types";

interface Props {
  items: Item[];
}

const { items } = Astro.props;
const total = items.reduce((sum, item) => sum + item.value, 0);
const labels = items.map((item) => item.label.toUpperCase());
---

<section>
  <h2>C11: {total}</h2>
  <p>{labels.join(", ")}</p>
  <C10 items={items} />
  <C9 items={items} />
</section>
